APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
TRUSTED_PROXIES=

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# Docker Compose: usar 'postgres' (nombre del servicio en docker-compose.yml)
# Fuera de Docker: usar '127.0.0.1' o el host real
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=hubdigital
DB_USERNAME=postgres
DB_PASSWORD=
# Docker Compose: usar 'disable' (la red interna no necesita SSL)
DB_SSLMODE=disable

# Base de datos local para tests de integración (NO usar Supabase)
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5432
TEST_DB_DATABASE=hubdigital
TEST_DB_USERNAME=postgres
TEST_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
DEPOSIT_STORAGE_DRIVER=auto
DEPOSIT_STORAGE_REQUIRE_REMOTE=false
DEPOSIT_STORAGE_VERIFY_AFTER_WRITE=true
DEPOSIT_STORAGE_MAX_OBJECT_BYTES=26214400
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
DOCUMENT_EXTRACTION_DRIVER=local
DOCUMENT_EXTRACTION_OCR_LANGUAGES=spa+eng
# En produccion no desactivar: exige que pdfsig reconozca la cadena de confianza.
FIRMA_EXIGIR_CERTIFICADO_CONFIABLE=true
# Base NSS con las raíces/intermedias acreditadas. pdfsig consulta OCSP por defecto.
FIRMA_NSS_DIR=
FIRMA_MAX_PAGES=200
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Solo desarrollo: habilita tres cuentas desechables para la prueba integral.
SEED_DEMO_USERS=false
DEMO_DEPOSITOS_PASSWORD=

# Cloudflare Tunnel (solo desarrollo/revisión remota; nunca versionar el token real)
CLOUDFLARE_TUNNEL_TOKEN=

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

    # Cuenta administrativa de curaduría que siembra CuradorSeeder.
# CURADOR_PASS es obligatoria: sin ella el seeder aborta en vez de usar una por defecto.
CURADOR_EMAIL=curador@epn.edu.ec
CURADOR_PASS=
